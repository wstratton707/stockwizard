# QuantWizard — secrets template.
#
# Copy to `.streamlit/secrets.toml` for local development (that file is
# gitignored).
#
# Where each setting has to go, per deployment — the two halves of this file are
# NOT interchangeable:
#
#   * The [auth] block is read via `st.secrets` (see auth.py). Streamlit copies
#     st.secrets INTO os.environ, never the other way round, and an environment
#     variable cannot express a nested TOML section anyway. So [auth] only works
#     from a real TOML file.
#   * Everything below it is read via `os.getenv` (see database.py), so a plain
#     environment variable is fine.
#
# Streamlit Community Cloud — paste this whole file into Manage app → Settings →
#   Secrets. That pane IS secrets.toml, so both halves work.
#
# Render (or any host with no secrets pane) — use ordinary environment
#   variables for everything, including auth. auth.py writes this file from them
#   at startup, so the five below are equivalent to the [auth] block:
#
#     AUTH_REDIRECT_URI          = this deployment's own /oauth2callback URL
#     AUTH_COOKIE_SECRET         = long random string, different per deployment
#     AUTH_CLIENT_ID             = from the provider
#     AUTH_CLIENT_SECRET         = from the provider
#     AUTH_SERVER_METADATA_URL   = https://<tenant>/.well-known/openid-configuration
#
#   All five must be set. A partial config is ignored on purpose — half an
#   [auth] block produces a button that fails when clicked, which is worse than
#   one that renders disabled.
#
#   A Render Secret File at /etc/secrets/secrets.toml still works and takes
#   precedence; the env vars are the simpler path.
#
# ─────────────────────────────────────────────────────────────────────────────
# SIGN-IN  (Streamlit native OIDC — see auth.py)
# ─────────────────────────────────────────────────────────────────────────────
# Without this block the app still runs; the Sign in button renders disabled and
# Your Portfolios shows a "not configured" note instead of crashing.
#
# Auth0 setup, once:
#   1. auth0.com → create a free tenant.
#   2. Applications → Create Application → "Regular Web Application".
#   3. Settings → Allowed Callback URLs. Add ONE PER DEPLOYMENT, comma separated
#      — each origin needs its own, and the path must be /oauth2callback:
#        http://localhost:8501/oauth2callback
#        https://<your-app>.streamlit.app/oauth2callback
#        https://<your-service>.onrender.com/oauth2callback
#   4. Allowed Logout URLs: the same origins, without the /oauth2callback path.
#   5. Authentication → Database → keep "Username-Password-Authentication"
#      enabled. That is what gives users an email + password.
#      (Social logins can be switched on later without touching any code.)
#   6. Copy Domain, Client ID and Client Secret into the block below.

[auth]
# This app's own URL with the /oauth2callback path — must exactly match one of
# the Allowed Callback URLs above, including http vs https.
redirect_uri  = "http://localhost:8501/oauth2callback"
# Any long random string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out. Use a DIFFERENT value per deployment.
cookie_secret = "replace-me-with-a-long-random-string"

[auth.auth0]
client_id           = "your-auth0-client-id"
client_secret       = "your-auth0-client-secret"
server_metadata_url = "https://YOUR-TENANT.us.auth0.com/.well-known/openid-configuration"

# ─────────────────────────────────────────────────────────────────────────────
# DATA + STORAGE
# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE_URL must be the PROJECT URL, not the REST endpoint — the code appends
# /rest/v1 itself. A trailing /rest/v1 is now stripped defensively, but set it
# correctly anyway.
SUPABASE_URL     = "https://your-project-ref.supabase.co"
SUPABASE_KEY     = "your-supabase-anon-key"

POLYGON_API_KEY  = "your-polygon-key"
FINNHUB_API_KEY  = "your-finnhub-key"    # optional — real-time quotes
FMP_API_KEY      = "your-fmp-key"        # optional — ETF holdings
ANTHROPIC_API_KEY = "your-anthropic-key" # optional — AI news brief

# ─────────────────────────────────────────────────────────────────────────────
# PAYMENTS (only needed once DEV_MODE_FREE = False in constants.py)
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY      = "sk_live_or_test_..."
STRIPE_PRICE_ID        = "price_...monthly"
# Optional. The annual toggle on the pricing card only appears when this is set —
# without it, selecting annual would have charged the monthly price.
STRIPE_PRICE_ID_ANNUAL = "price_...annual"

# ── Market data ───────────────────────────────────────────────────────────────
# Polygon (now "Massive") — bulk/grouped endpoints (ticker tape, movers, the
# 328-stock rankings) and the fallback for quotes/bars. Required.
POLYGON_API_KEY=your_polygon_api_key_here

# Finnhub — OPTIONAL but recommended. Free tier gives REAL-TIME US stock quotes
# (60/min). When set, the single-ticker hero price goes live; when unset, quotes
# fall back to Polygon (delayed) and the app works unchanged. Get a free key at
# https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# yfinance (Yahoo Finance) needs no key — it's the primary source for historical
# bars (same-day, deep history). Used automatically via market_data.py.

# Supabase — persistent cache + saved portfolios.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# ── Payments (only needed when DEV_MODE_FREE is off) ────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID=price_...
